@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Organiser Dashboard";
    var userName = Context.Session.GetString("UserName") ?? "Organiser";
}

<div class="container py-5">

    <!-- Welcome Section -->
    <div class="p-5 mb-5 rounded-4 bg-dark text-white shadow">
        <h1 class="display-5 fw-bold">
            Welcome, @userName!
        </h1>

        <p class="lead mt-3">
            Manage your races, review event information,
            and help participants have a great racing experience.
        </p>

        <a asp-controller="Events"
           asp-action="Index"
           class="btn btn-primary btn-lg mt-3">
            View Events
        </a>
    </div>

    <!-- Dashboard Options -->
    <h2 class="fw-bold mb-4">Organiser Dashboard</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <div class="fs-1 mb-3">race</div>

                    <h4 class="fw-bold">View Events</h4>

                    <p class="text-muted">
                        Review the events currently available
                        in RaceDay.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary w-100">
                        Browse Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <div class="fs-1 mb-3">results</div>

                    <h4 class="fw-bold">Race Results</h4>

                    <p class="text-muted">
                        Review the race results available
                        through the system.
                    </p>

                    <a asp-controller="Results"
                       asp-action="Index"
                       class="btn btn-outline-primary w-100">
                        View Results
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <div class="fs-1 mb-3">category</div>

                    <h4 class="fw-bold">Event Categories</h4>

                    <p class="text-muted">
                        Review event categories available
                        for organising races.
                    </p>

                    <a asp-controller="Categories"
                       asp-action="Index"
                       class="btn btn-outline-primary w-100">
                        View Categories
                    </a>
                    <div class="col-md-4">
    <div class="card h-100 shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <div class="fs-1 mb-3">evvents</div>

            <h4 class="fw-bold">Manage Events</h4>

            <p class="text-muted">
                Access your event management workspace.
            </p>

            <a asp-controller="OrganiserEvents"
               asp-action="Index"
               class="btn btn-primary w-100">
                Manage Events
            </a>
        </div>
    </div>
</div>
                </div>
            </div>
        </div>

    </div>

    <div class="alert alert-info mt-5 rounded-3">
        <strong>Organiser Tip:</strong>
        Keep event information accurate and ensure race results
        are updated when available.
    </div>

</div>