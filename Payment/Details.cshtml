@model RaceDay222MVC.Models.PaymentViewModel

@{
    ViewData["Title"] = "Payment Details";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 mx-auto" style="max-width: 650px;">

        <div class="card-header bg-dark text-white p-4">
            <h2 class="fw-bold mb-0">Payment Details</h2>
        </div>

        <div class="card-body p-4">

            <div class="text-center mb-4">
                <div class="display-3">💳</div>
                <h3 class="fw-bold mt-2">
                    @Model.Amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))
                </h3>
                <span class="badge bg-info text-dark">
                    @(string.IsNullOrWhiteSpace(Model.Status)
                        ? "Pending"
                        : Model.Status)
                </span>
            </div>

            <hr />

            <p><strong>Payment ID:</strong> @Model.PaymentID</p>
            <p><strong>Enrollment ID:</strong> @Model.EnrollmentID</p>
            <p><strong>Payment Method:</strong> @Model.PaymentMethod</p>
            <p>
                <strong>Payment Date:</strong>
                @(Model.PaymentDate.HasValue
                    ? Model.PaymentDate.Value.ToString("dd MMMM yyyy")
                    : "Not recorded")
            </p>

            <a asp-action="Index" class="btn btn-primary mt-3">
                Back to Payments
            </a>
        </div>
    </div>
</div>
