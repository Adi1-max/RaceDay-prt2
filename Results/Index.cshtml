@model IEnumerable<RaceDay222MVC.Models.ResultsViewModel>

@{
ViewData["Title"] = "Race Results";
}

<div class="container py-5">

```
<div class="p-4 p-md-5 mb-5 rounded-4 bg-dark text-white shadow">
    <span class="badge bg-primary mb-3">RACEDAY LEADERBOARD</span>

    <h1 class="display-5 fw-bold">Race Results</h1>

    <p class="lead mb-0">
        Review race performances, positions, and recorded times.
    </p>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-warning">
        @ViewBag.ErrorMessage
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Results Leaderboard</h2>
        <p class="text-muted mb-0">
            Official results available in RaceDay.
        </p>
    </div>

    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-outline-primary">
        Browse Events
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body text-center p-5">

            <div class="display-4 mb-3">🏆</div>

            <h4>No Results Available</h4>

            <p class="text-muted">
                Race results have not been published or could not be loaded.
                Please check again later.
            </p>

        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle shadow-sm">

            <thead class="table-dark">
                <tr>
                    <th>Position</th>
                    <th>Event</th>
                    <th>Participant</th>
                    <th>Finishing Time</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var result in Model.OrderBy(r => r.Position))
                {
                    <tr>
                        <td>
                            @if (result.Position == 1)
                            {
                                <span class="badge bg-warning text-dark">
                                     1st place 
                                </span>
                            }
                            else if (result.Position == 2)
                            {
                                <span class="badge bg-secondary">
                                     2nd place
                                </span>
                            }
                            else if (result.Position == 3)
                            {
                                <span class="badge bg-danger">
                                     3rd place
                                </span>
                            }
                            else
                            {
                                <span class="fw-semibold">
                                    @result.Position
                                </span>
                            }
                        </td>

                        <td>@result.EventName</td>

                        <td>@result.ParticipantName</td>

                       <td>
    @if (!string.IsNullOrEmpty(result.Time))
    {
        @result.Time
    }
    else
    {
        <span class="text-muted">Not recorded</span>
    }
</td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}

<div class="mt-4">
    <a asp-controller="ParticipantDashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>
</div>


</div>
